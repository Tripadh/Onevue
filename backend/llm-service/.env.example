# ==============================================================================
# ONEVUE LLM Service Configuration
# Copy this file to .env and configure your local environment settings.
# DO NOT commit real secrets or credentials into version control.
# ==============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Service Build & Runtime Metadata
# Optional Git commit SHA injected during container build or deployment.
# If unset or empty, /version explicitly returns null for commit_sha.
GIT_COMMIT_SHA=

# Observability & Metrics Protection
# Separate authentication token protecting the Prometheus /metrics endpoint.
# If unset, the /metrics endpoint is disabled and returns 404/fail-closed.
METRICS_TOKEN=your-dedicated-metrics-token-here

# Optional Error Reporting (Sentry-compatible)
# Kept disabled by default (false). Requires explicit configuration.
ERROR_REPORTING_ENABLED=false
SENTRY_DSN=

# Internal Service Authentication (used for client-to-service authorization)
LLM_SERVICE_API_KEY=your-service-api-key-here
SERVICE_API_KEY=your-service-api-key-here

# LLM Providers Configuration (Keep server-side only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com
GROQ_REQUEST_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=3

# Input Limits
MAX_INPUT_CHARS=24000

NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REQUEST_TIMEOUT_SECONDS=30.0
NVIDIA_MAX_RETRIES=2

# Quota and Call Guards (Process-local)
MAX_PROVIDER_CALLS_PER_REQUEST=4
PROVIDER_RATE_LIMIT_PER_MINUTE=40
ENABLE_PROCESS_RATE_GUARD=true

# Execution Modes
# Set MOCK_MODE=true for local development/testing without live LLM API calls
MOCK_MODE=false
