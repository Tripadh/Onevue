{
  "openapi": "3.1.0",
  "info": {
    "title": "ONEVUE LLM Service",
    "description": "Microservice responsible for LLM resume extraction and portfolio synthesis.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Returns operational status and version without exposing secrets.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Readiness Check",
        "description": "Verifies whether the service has the local configuration and initialized components required to accept requests. Does not perform live provider calls. Readiness is not proof that external provider APIs are reachable.",
        "operationId": "readiness_check_ready_get",
        "responses": {
          "200": {
            "description": "Service is ready to accept requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service is unconfigured or unavailable."
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Service Version",
        "description": "Returns service version and runtime metadata. Git commit SHA is returned only when available from runtime/build configuration; otherwise null.",
        "operationId": "version_info_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Protected Prometheus Metrics",
        "description": "Returns low-cardinality Prometheus metrics in text format. Protected by METRICS_TOKEN. Disabled if METRICS_TOKEN is unset.",
        "operationId": "get_metrics_metrics_get",
        "responses": {
          "200": {
            "description": "Low-cardinality operational metrics in Prometheus text format.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/plain; version=0.0.4; charset=utf-8": {}
            }
          },
          "401": {
            "description": "Missing or invalid metrics authentication token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          },
          "404": {
            "description": "Metrics endpoint is disabled (METRICS_TOKEN unset).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          }
        },
        "security": [
          {
            "MetricsTokenAuth": []
          }
        ]
      }
    },
    "/": {
      "get": {
        "summary": "Service Information",
        "description": "Identifies service and directs clients to interactive documentation.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/extract": {
      "post": {
        "summary": "Extract Resume Profile",
        "description": "Extracts structured resume candidate profile from an uploaded PDF document. Requires X-API-Key authentication.",
        "operationId": "extract_resume_v1_extract_post",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_resume_v1_extract_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured extraction candidate profile. The status field indicates whether extraction completed cleanly ('ok') or with partial normalization ('partial').",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid file upload, empty payload, or PDF parser failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or unconfigured service API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          },
          "413": {
            "description": "Uploaded PDF exceeds maximum allowed file size.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable document (exceeds page limit, encrypted, or scanned PDF).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          },
          "429": {
            "description": "Provider rate limit or process-local rate guard reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          },
          "502": {
            "description": "Upstream provider credential failure or malformed provider response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          },
          "503": {
            "description": "Upstream provider unavailable, circuit breaker open, or concurrency queue timeout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          },
          "504": {
            "description": "Extraction deadline exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredError"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
