PORT=3000

# Required to start the service. The process exits when this is missing
# and does not fall back to in-memory storage.
# Replace USER and PASSWORD locally. Do not commit a real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/certificate_verification

# Optional dedicated database for integration tests. Tests ignore DATABASE_URL.
# The database name must contain "test". The suite deletes rows in that database.
# CERTIFICATE_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/certificate_verification_test
