PORT=3001

# Required to start the service. The process exits when this is missing
# and does not fall back to in-memory storage.
# Use the same MongoDB deployment as the Onevue platform. Replace USER and PASSWORD locally.
# Do not commit a real .env file.
MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/certificate_verification

# Shared with the platform backend. When set, certificate routes require
# Authorization: Bearer <token> and X-Onevue-User-Id. Leave unset only for
# the service's own local tests, which then store the local development user.
CERTIFICATE_SERVICE_TOKEN=replace-with-a-long-random-token

# Optional dedicated database for manual integration tests. The database name
# must contain "test". Automated tests use an ephemeral MongoDB instead.
# CERTIFICATE_TEST_MONGODB_URI=mongodb://USER:PASSWORD@localhost:27017/certificate_verification_test
