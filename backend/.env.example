# MongoDB connection string. The platform and certificate verification service
# use this same deployment. Do not commit a real .env or .env.local file.
MONGODB_URI="mongodb://USER:PASSWORD@localhost:27017/onevue"

# JWT secret for user authentication tokens. Required.
# Must be a cryptographically secure random secret of at least 32 characters (256 bits).
# Generate locally using e.g.: openssl rand -base64 32
# Never commit real secrets or .env.local to version control.
JWT_SECRET="replace-with-a-secure-random-jwt-secret-at-least-32-characters"

# Internal certificate verification service. The browser never receives these.
CERTIFICATE_SERVICE_URL="http://127.0.0.1:3002"
CERTIFICATE_SERVICE_TOKEN="replace-with-a-long-random-token"
CERTIFICATE_SERVICE_TIMEOUT_MS="20000"

# Internal LLM extraction service. Provider keys stay in backend/llm-service/.env.
# Extraction output is not certificate verification.
LLM_SERVICE_URL="http://127.0.0.1:8000"
LLM_SERVICE_API_KEY="replace-with-the-llm-service-api-key"
# Must stay above the LLM service EXTRACTION_DEADLINE_SECONDS (60).
# Values at or below 70 seconds are raised to 70 seconds, and none wait past 90.
LLM_SERVICE_TIMEOUT_MS="70000"

# Isolated template build runtime. Leave execution disabled until a verified
# runtime adapter is integrated. A child process is not an isolation boundary.
ENABLE_ISOLATED_BUILD_EXECUTION="false"
# ONEVUE_BUILD_ISOLATION_RUNTIME="docker"
# ONEVUE_BUILD_ISOLATION_BINARY="/usr/bin/docker"
# ONEVUE_BUILD_ISOLATION_IMAGE="registry.example.invalid/onevue/build@sha256:REPLACE_WITH_64_HEX_DIGEST"
# ONEVUE_BUILD_NETWORK_MODE="none"
# ONEVUE_BUILD_READ_ONLY_ROOTFS="true"
# ONEVUE_BUILD_TIMEOUT_MS="300000"
# ONEVUE_BUILD_MEMORY_MB="512"
# ONEVUE_BUILD_CPU_LIMIT="1"
# ONEVUE_BUILD_PIDS_LIMIT="128"
# ONEVUE_BUILD_ENV_ALLOWLIST="NODE_ENV"
# ONEVUE_BUILD_MAX_OUTPUT_BYTES="268435456"
# Absolute, pre-populated package cache for offline installs (read-only /deps).
# Populate on a networked host, e.g.:
#   npm cache add <pkg>@<version> --cache /var/lib/onevue/npm-cache
# ONEVUE_BUILD_DEPENDENCY_CACHE_DIR="/var/lib/onevue/npm-cache"

# ---------------------------------------------------------------------------
# Template pipeline (GitHub URL -> isolated build -> immutable artifact ->
# catalog -> student selection -> visitor delivery). No secrets in this file.
# ---------------------------------------------------------------------------
# Absolute roots on persistent storage. The artifact root defaults to
# <repo>/.local-template-storage; the snapshot root has no default and ingestion
# fails closed without it.
ONEVUE_TEMPLATE_STORAGE_ROOT="/absolute/path/to/onevue/templates"
ONEVUE_SOURCE_SNAPSHOT_ROOT="/absolute/path/to/onevue/snapshots"

# Total wall-clock budget for downloading a source archive, in milliseconds.
# This is the budget for the WHOLE download, not for a single attempt: every
# attempt additionally gets its own bounded slice of it, so a retry always has
# real time left to work with. Raise it for large repositories — a cold
# GitHub tarball can take well over a minute. Defaults to 120000 (2 minutes).
# ONEVUE_GITHUB_ARCHIVE_TIMEOUT_MS="120000"

# Server-side GitHub credentials. Never expose these to the frontend.
#
# Read credential (ingestion of source repositories):
#   fine-grained PAT -> "Contents: Read" on the repositories being ingested.
#   Classic PAT       -> "repo:read" (public sources only: "public_repo").
# GITHUB_READ_TOKEN="fine-grained-token-with-contents-read"
#
# Write credential (private mirror under the target organization):
#   fine-grained PAT -> Organization "Administration: Read & write"
#                       AND Repository "Contents: Read & write",
#                       applied to the target organization (default: qubort-tech).
#   Classic PAT       -> "admin:org" and "repo".
#   The token's user must be a member of the organization with a role that may
#   create repositories. Keep this credential separate from the read token.
# GITHUB_PROVISIONING_TOKEN="separate-write-token-for-qubort-tech"
#
# Enables the live provisioning executor. Must be exactly "true"; anything
# else fails closed and the local mock executor is used outside production.
# ENABLE_LIVE_GITHUB_PROVISIONING="true"

# Live private-repository provisioning test (explicitly gated, creates and
# then deletes a real repository):
#   ONEVUE_LIVE_GITHUB_PROVISION=1
#   GITHUB_PROVISIONING_TOKEN=<token>
#   [ONEVUE_LIVE_GITHUB_ORG=qubort-tech]
#   [ONEVUE_LIVE_GITHUB_REPO=onevue-provisioning-smoke-<unique>]
# The repository name must start with "onevue-provisioning-smoke-" unless
# ONEVUE_LIVE_GITHUB_ALLOW_ANY_REPO=1 is set.

# Optional Cloudflare R2 artifact transport (not verified).
# ENABLE_LIVE_R2_STORAGE="false"
# CLOUDFLARE_R2_ACCOUNT_ID=""
# CLOUDFLARE_R2_ACCESS_KEY_ID=""
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
# CLOUDFLARE_R2_BUCKET_NAME="onevue-templates"
# CLOUDFLARE_R2_PUBLIC_BASE_URL=""

# MongoDB integration test database (dedicated test DB only). Used by
# backend/tests/mongo_persistence.integration.test.js.
# ONEVUE_TEST_MONGODB_URI="mongodb://127.0.0.1:27017/onevue_itest"
