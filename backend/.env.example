# MongoDB connection string
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/onevue?retryWrites=true&w=majority"

# JWT secret for authentication tokens.
# Required in production. Authentication fails closed when this is missing
# or set to the insecure value "fallback_secret".
JWT_SECRET="your_jwt_secret_key_here"

# Dedicated HMAC secret for analytics visitor and session identifiers.
# Falls back to JWT_SECRET when unset. Set a distinct value in production.
ANALYTICS_HASH_SECRET="replace-with-a-long-random-secret"

# In-process collector limit per client key. Not shared across serverless instances.
ANALYTICS_RATE_LIMIT_PER_MINUTE=60

# Days before stored events expire. 0 keeps events until a retention job is added.
ANALYTICS_RETENTION_DAYS=0
