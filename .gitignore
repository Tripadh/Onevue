# Environment secrets
.env
.env.*
!.env.example
!.*/.env.example
!.**/.env.example

# Node.js dependencies
node_modules/
*/node_modules/
.npm/
.pnp
.pnp.js

# Build output and caches
dist/
*/dist/
build/
*/build/
# The admin template build API route lives in a directory named "build";
# the generic build-output rule above would otherwise ignore it.
!backend/app/api/admin/templates/build/
out/
*/out/
.next/
*/.next/
.content-collections/
*/.content-collections/

# TypeScript
*.tsbuildinfo
next-env.d.ts
*/next-env.d.ts

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Coverage and testing
coverage/
*/coverage/

# Vercel
.vercel/
*/.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Certificates and private keys
*.pem
*.key

# IDE and operating system
.idea/
.vscode/
.DS_Store
Thumbs.db

# Temporary files
.~lock.*
*.tmp

# Local template artifact storage (backend artifact storage bridge).
# Regenerate with: node backend/scripts/seed_local_template_artifact.js
.local-template-storage/

# Local template pipeline runtime state (generated on this machine; never committed).
# Retained source snapshots, isolated build sandboxes and fetched source trees.
.local-source-snapshots/
.phase11-isolated/
template-sources/

# Local agent tooling workspaces.
.agent/
.agents/
.gsd/
.gemini/
graphify-out/

# Local credential material and archives.
ENV.txt
*.zip
.tmp-stage-list.txt
