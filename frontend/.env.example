# Copy to .env when moving to a bundler (Vite: VITE_API_MODE / VITE_API_URL)
API_MODE=mock        # mock | live
API_URL=https://api.onevue.id/v1
PUBLIC_BASE=onevue.id

# The static frontend calls the platform backend at http://localhost:3000/api.
# Certificate verification and LLM extraction are server-side only.
